rules_version = '2';

// Security rules for the SuaNeAni website (Firebase project suaneani-ba54b).
// Publish them in the Firebase console: Firestore Database > Rules > paste > Publish.
//
// Who can do what:
//  - Visitors can only create form submissions and read published content.
//  - Admins (signed-in users with a document at /admins/{their uid}) can read
//    submissions and edit all content. Admin documents can only be created
//    from the Firebase console, never from the website.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function optionalString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function requiredString(d, key, max) {
      return key in d && d[key] is string && d[key].size() > 0 && d[key].size() <= max;
    }

    function validSubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'topic', 'name', 'email', 'institution', 'subject', 'message', 'page', 'status', 'createdAt'])
        && d.type in ['contact', 'partner']
        && requiredString(d, 'name', 200)
        && requiredString(d, 'email', 200)
        && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && requiredString(d, 'message', 5000)
        && optionalString(d, 'topic', 100)
        && optionalString(d, 'institution', 200)
        && optionalString(d, 'subject', 100)
        && optionalString(d, 'page', 100)
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    // Form submissions from the website (contact form, partner enquiries).
    match /submissions/{id} {
      allow create: if validSubmission();
      allow read, update, delete: if isAdmin();
    }

    // Admin list. An admin can check their own entry (used by the dashboard
    // to confirm access); nobody can write here from the website.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Single settings documents: content/contact, content/impact.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lists edited from the dashboard. Visitors only see published items.
    function isContentList(name) {
      return name in ['testimonials', 'partners', 'gallery', 'news', 'faqs'];
    }

    match /{collectionName}/{id} {
      allow read: if isContentList(collectionName)
        && (resource.data.published == true || isAdmin());
      allow write: if isContentList(collectionName) && isAdmin();
    }
  }
}
